# ==============================================================================
# Sabha AI — Environment Configuration
# Tagline: Every conversation. A smarter decision.
# ==============================================================================

# Core Application
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace_with_a_secure_random_64_char_secret_key

# Database
# Default: SQLite for immediate local zero-dependency development
# Production: PostgreSQL (e.g. postgresql://user:password@localhost:5432/sabha_db)
DATABASE_URL=sqlite:///./sabha.db

# ==============================================================================
# EXCLUSIVE LLM INFERENCE PROVIDER: Qualcomm Cloud AI Playground
# Note: Per architectural requirement, all LLM intelligence is exclusively routed
# through Qualcomm Cloud AI Playground. No third-party LLMs are permitted.
# ==============================================================================
QUALCOMM_API_KEY=your_qualcomm_cloud_ai_api_key_here
QUALCOMM_ENDPOINT=https://api.cloudai.qualcomm.com/v1

# Qualcomm Cloud AI Model Assignment
QUALCOMM_ROUTINE_MODEL=Llama-3.1-8B
QUALCOMM_COMPLEX_MODEL=Llama-3.3-70B
QUALCOMM_REASONING_MODEL=deepseek-r1-distill-llama-70b
QUALCOMM_CREATIVE_MODEL=Qwen-QwQ-32B

# ==============================================================================
# Research & Web Retrieval (Separate from LLM inference)
# Used for fetching verifiable source citations; synthesis uses Qualcomm LLM
# ==============================================================================
TAVILY_API_KEY=optional_tavily_api_key_for_external_search

# ==============================================================================
# LiveKit Real-Time WebRTC Media Infrastructure (Mode A: Live Meetings)
# ==============================================================================
LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ==============================================================================
# Token Budget & Safety Guardrails
# ==============================================================================
MAX_MEETING_BUDGET_USD=2.50
MAX_INPUT_TOKENS_PER_REQ=16000
MAX_OUTPUT_TOKENS_PER_REQ=4096
MAX_RESEARCH_CALLS_PER_MEETING=5
